<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No cleartext anywhere, including the endpoint that ships the profile. A document
         that decides where a user's packets go must never arrive over plain HTTP. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
